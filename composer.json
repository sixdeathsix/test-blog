{
    "name": "test/blog",
    "description": "Blog with categories and articles: plain PHP, Smarty, MySQL",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "smarty/smarty": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
